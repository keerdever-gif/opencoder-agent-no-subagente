# Required: configure at least one AI provider key.
AI_API_KEY=your_ai_provider_api_key
AI_MODEL=gemini-flash-lite-latest
# Optional OpenAI-compatible provider URL.
# AI_API_BASE_URL=https://api.example.com/v1

# Web access. Set a long random token before exposing the server publicly.
WEB_ACCESS_TOKEN=change-this-token
WEB_HOST=0.0.0.0

# Optional PostgreSQL persistence. Without it, memory is session-only.
DATABASE_URL=

# Optional integrations.
GITHUB_TOKEN=
VERCEL_TOKEN=
E2B_API_KEY=
FLUX_API_KEY_1=
FLUX_API_KEY_2=

# Agent settings.
BOT_NAME=OpenCoder-Agent
OPENCODER_WORKSPACE=./workspace
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=600
MAX_SAFETY_ROUNDS=100
VERIFY_CODE=1
MAX_FIX_ATTEMPTS=8
CODE_RUN_TIMEOUT=20
MEMORY_LIMIT=120
MEMORY_MESSAGES=12
